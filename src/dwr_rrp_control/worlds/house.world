    </model>
    <model name="wall_bottom">
      <pose>10.0 0.0 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>20.0 0.2 2.0</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual>
