    <!-- ========== 靠墙取物桌 (物体放置处) ========== -->
    <!-- 左墙药品桌 y=4，红色桌面 -->
    <model name="table_left_medicine">
      <pose>0.5 4.0 0.75 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.3 0.6 1.0</size></box></geometry><material><ambient>0.8 0.2 0.1 1</ambient></material></visual>
        <collision name="collision"><geometry><box><size>0.3 0.6 1.0</size></box></geometry></collision>
        <inertial><mass>25</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
      </link>
      <static>true</static>
    </model>
    <model name="medicine">
      <pose>0.5 4.0 1.55 0 0 0</pose>   <!-- 高度从1.45改为1.55 -->
      <link name="link">
        <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.1</size></box></geometry><material><ambient>1 0 0 1</ambient></material></visual>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.1</size></box></geometry></collision>
      </link>
    </model>

    <!-- 右墙水杯桌 y=11，蓝色桌面 -->
    <model name="table_right_water">
      <pose>19.5 11.0 0.75 0 0 3.14159</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.3 0.6 1.0</size></box></geometry><material><ambient>0.1 0.3 0.8 1</ambient></material></visual>
