<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- =================================================== -->
    <!--            复合移动机器人 (DWR + RRP 机械臂)            -->
    <!-- =================================================== -->
    <model name="dwr_rrp_robot">
      <pose>4 1 0.2 0 0 1.57079632679</pose>

      <!-- ==================== 1. DWR 车体部分 ==================== -->
      <link name="chassis">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>10.0</mass>
          <inertia>
            <ixx>0.1</ixx><iyy>0.1</iyy><izz>0.2</izz>
          </inertia>
        </inertial>

        <visual name="chassis_visual">
          <geometry>
            <box><size>0.7 0.7 0.1</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
        <collision name="chassis_collision">
          <geometry>
            <box><size>0.7 0.7 0.1</size></box>
          </geometry>
        </collision>

        <visual name="caster_front_visual">
          <pose>0.25 0 -0.1 0 0 0</pose>
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
        <collision name="caster_front_collision">
          <pose>0.25 0 -0.1 0 0 0</pose>
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
          </surface>
        </collision>

        <visual name="caster_rear_visual">
          <pose>-0.25 0 -0.1 0 0 0</pose>
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
        <collision name="caster_rear_collision">
          <pose>-0.25 0 -0.1 0 0 0</pose>
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
          </surface>
        </collision>
      </link>

      <link name="left_wheel">
        <pose>0 0.4 0 -1.57079632679 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.1</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Black</name>
            </script>
          </material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>0.1</length></cylinder></geometry>
        </collision>
      </link>

      <link name="right_wheel">
        <pose>0 -0.4 0 -1.57079632679 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.1</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Black</name>
            </script>
          </material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>0.1</length></cylinder></geometry>
        </collision>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <!-- ==================== 2. RRP 机械臂部分 ==================== -->
      <link name="base_link">
        <pose>0 0 0.1 0 0 0</pose>
        <inertial>
          <mass>20.0</mass>
          <inertia>
            <ixx>0.2</ixx><iyy>0.2</iyy><izz>0.4</izz>
          </inertia>
        </inertial>
        <collision name="base_collision">
          <geometry><box><size>0.6 0.6 0.1</size></box></geometry>
        </collision>
        <visual name="base_visual">
          <geometry><box><size>0.6 0.6 0.1</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Orange</name>
            </script>
          </material>
        </visual>
      </link>

      <joint name="chassis_to_arm_base" type="fixed">
        <parent>chassis</parent>
        <child>base_link</child>
      </joint>

      <link name="link1">
        <pose>0 0 0.15 0 0 0</pose>
        <inertial>
          <pose>0 0 0.5 0 0 0</pose>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.4</ixx><iyy>0.4</iyy><izz>0.02</izz>
          </inertia>
        </inertial>
        <collision name="link1_collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="link1_visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/SkyBlue</name>
            </script>
          </material>
        </visual>
        <visual name="joint2_visual">
           <pose>0 0 1.0 1.5707963 0 0</pose>
           <geometry><cylinder><radius>0.12</radius><length>0.25</length></cylinder></geometry>
           <material>
             <script>
               <uri>file://media/materials/scripts/gazebo.material</uri>
               <name>Gazebo/SkyBlue</name>
             </script>
           </material>
        </visual>
      </link>

      <joint name="joint1" type="revolute">
        <parent>base_link</parent>
        <child>link1</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-3.14159</lower>
            <upper>3.14159</upper>
            <effort>200</effort>
            <velocity>2.0</velocity>
          </limit>
        </axis>
      </joint>

      <link name="link2">
        <pose>0 0 1.15 0 0 0</pose>
        <inertial>
          <pose>0 0.4 0 0 0 0</pose> 
          <mass>3.0</mass>
          <inertia>
            <ixx>0.2</ixx><iyy>0.01</iyy><izz>0.2</izz>
          </inertia>
        </inertial>
        <collision name="link2_collision">
          <pose>0 0.4 0 1.5707963 0 0</pose> 
          <geometry><cylinder><radius>0.05</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="link2_visual">
          <pose>0 0.4 0 1.5707963 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.8</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkGrey</name>
            </script>
          </material>
        </visual>
        <visual name="sleeve_visual">
          <pose>0 0.8 0 0 0 0</pose>
          <geometry><box><size>0.12 0.12 0.2</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/SkyBlue</name>
            </script>
          </material>
        </visual>
      </link>

      <joint name="joint2" type="revolute">
        <parent>link1</parent>
        <child>link2</child>
        <axis>
          <xyz>0 1 0</xyz> 
          <limit>
            <lower>-1.5707</lower>
            <upper>1.60</upper>
            <effort>200</effort>
            <velocity>1.5</velocity>
          </limit>
        </axis>
      </joint>

      <!-- ==================== 3. 伸缩杆与夹爪 ==================== -->
      <link name="link3">
        <pose>0 0.8 1.15 0 0 0</pose> 
        <inertial>
          <pose>0 0 0.25 0 0 0</pose>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.01</ixx><iyy>0.01</iyy><izz>0.002</izz>
          </inertia>
        </inertial>
        <collision name="link3_collision">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="link3_visual">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.5</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkGrey</name>
            </script>
          </material>
        </visual>
        
        <!-- U型底座（末端执行器） -->
        <visual name="ee_visual">
          <pose>0 0 0.51 0 0 0</pose>
          <geometry>
            <box><size>0.04 0.20 0.02</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
        <collision name="ee_collision">
          <pose>0 0 0.51 0 0 0</pose>
          <geometry>
            <box><size>0.04 0.20 0.02</size></box>
          </geometry>
        </collision>
      </link>

      <joint name="joint3" type="prismatic">
        <parent>link2</parent>
        <child>link3</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-0.4</lower>
            <upper>0.1</upper>
            <effort>300</effort>
            <velocity>1.0</velocity>
          </limit>
          <dynamics>
            <damping>0.01</damping>
            <friction>0.01</friction>
          </dynamics>
        </axis>
      </joint>

      <joint name="left_finger_joint" type="prismatic">
        <parent>link3</parent>
        <child>left_finger</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>0</lower><upper>0.05</upper><effort>20</effort></limit>
        </axis>
      </joint>
      <link name="left_finger">
        <pose>0 0.85 1.71 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
        <collision name="col"><geometry><box><size>0.04 0.01 0.08</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.04 0.01 0.08</size></box></geometry></visual>
      </link>

      <joint name="right_finger_joint" type="prismatic">
        <parent>link3</parent>
        <child>right_finger</child>
        <axis>
          <xyz>0 -1 0</xyz>
          <limit><lower>0</lower><upper>0.05</upper><effort>20</effort></limit>
        </axis>
      </joint>
      <link name="right_finger">
        <pose>0 0.75 1.71 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
        <collision name="col"><geometry><box><size>0.04 0.01 0.08</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.04 0.01 0.08</size></box></geometry></visual>
      </link>

      <!-- ==================== 4. 控制插件 ==================== -->
      <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <rosDebugLevel>Debug</rosDebugLevel>
        <publishWheelTF>true</publishWheelTF>
        <robotNamespace>/</robotNamespace>
        <publishTf>1</publishTf>
        <publishWheelJointState>true</publishWheelJointState>
        <alwaysOn>true</alwaysOn>
        <updateRate>100.0</updateRate>
        <leftJoint>left_wheel_joint</leftJoint>
        <rightJoint>right_wheel_joint</rightJoint>
        <wheelSeparation>0.8</wheelSeparation>
        <wheelDiameter>0.4</wheelDiameter>
        <torque>20</torque>
        <commandTopic>cmd_vel</commandTopic>
        <odometryTopic>odom</odometryTopic>
        <odometryFrame>odom</odometryFrame>
        <robotBaseFrame>chassis</robotBaseFrame>
      </plugin>
    </model>
</sdf>
